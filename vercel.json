{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter client build",
  "installCommand": "pnpm install --frozen-lockfile --filter client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://proyecto-prueba-push-firebase.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
