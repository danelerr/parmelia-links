@startuml
!include _theme.puml
title Despliegue físico — recut semántico promovido y pagos live desactivados

left to right direction
skinparam linetype ortho

node "Navegador" as browser {
  artifact "App + ruta checkout\n[remoto actual; auth anterior]" as app_web COLOR_WEB
  artifact "Dashboard\n[login GatoPago público]" as dashboard_web COLOR_WEB
}

cloud "Vercel" as vercel COLOR_EXTERNAL {
  artifact "client/dist\napp.parmelia.me\n[desplegado]" as client_dist COLOR_LIVE
  artifact "dashboard/dist\ndashboard.parmelia.me\n[desplegado; sin Vercel SSO]" as dashboard_dist COLOR_LIVE
}

cloud "Cloudflare" as cf {
  node "Workers Edge" {
    component "server\nApp Backend\n[desplegado]" as app_worker COLOR_LIVE
    component "gatopago-payments-api\nPayments Backend\n[desplegado]" as payments_worker COLOR_LIVE
  }

  database "parmeliadb\nGATOPAGO_DB\n[desplegada]" as app_d1 COLOR_LIVE
  queue "parmelia-scheduled-jobs\n+ DLQ\n[desplegadas]" as app_queue COLOR_LIVE
  component "EventJobScheduler +\nRpcAdmissionController\nDurable Objects" as app_do COLOR_LIVE

  database "gatopago-payments-semantic-20260826\nPAYMENTS_DB activa\n[manifest v4; checksum v2]" as payments_d1 COLOR_LIVE
  database "gatopago-payments\nD1 histórica del 25-08\n[retenida; sólo auditoría/rollback]" as historical_payments_d1 COLOR_FUTURE
  queue "gatopago-payment-jobs\n+ DLQ\n[creadas]" as payments_queue COLOR_LIVE
  component "PaymentJobScheduler\nDurable Object\n[desplegado]" as payments_do COLOR_LIVE
  component "Cron recovery sweep\n*cada minuto*" as payments_cron COLOR_LIVE

  artifact "Secrets App\nidentidad, sponsorship, RPC, ops" as app_secrets COLOR_DATA
  artifact "Secrets Payments\nsigner, relayer CCTP, RPC,\nwebhook AES, ops token" as payments_secrets COLOR_DATA
}

cloud "Firebase Auth\nGoogle + Email Link" as identity COLOR_EXTERNAL
cloud "RPC providers" as rpc COLOR_EXTERNAL
cloud "Circle Iris API" as circle COLOR_EXTERNAL
artifact "Candidato Fase 3 App\nclient + server + 0035\n[local; promoción pendiente]" as phase3_candidate COLOR_READY

node "Arbitrum Sepolia — home" as arbitrum COLOR_EXTERNAL {
  component "Smart accounts + EntryPoint" as accounts
  component "PaymentRouterV2" as home_router
  component "MessageTransmitter + USDC" as arb_cctp
}

node "Base Sepolia — origen" as base COLOR_EXTERNAL {
  component "CCTP PaymentRouter" as base_router
  component "USDC + TokenMessenger" as base_cctp
}

node "Avalanche Fuji — origen" as avalanche COLOR_EXTERNAL {
  component "CCTP PaymentRouter" as avax_router
  component "USDC + TokenMessenger" as avax_cctp
}

client_dist --> app_web : descarga
dashboard_dist --> dashboard_web : descarga
app_web --> app_worker : identidad / wallet
app_web --> payments_worker : links / checkout
dashboard_web --> app_worker : autenticación
dashboard_web --> payments_worker : merchant
app_worker --> payments_worker : Service Binding PAYMENTS

app_worker --> app_d1
app_worker --> app_queue
app_do --> app_queue
app_secrets --> app_worker

payments_worker --> payments_d1
payments_worker ..> historical_payments_d1 : sin escrituras\nretención histórica
payments_worker --> payments_queue : produce
payments_queue --> payments_worker : consume / redelivery
payments_do --> payments_queue : jobs diferidos
payments_cron --> payments_worker : recuperación
payments_secrets --> payments_worker

app_worker --> identity
app_worker --> rpc
payments_worker --> identity
payments_worker --> rpc
app_worker --> circle : attestation CCTP personal
payments_worker --> circle : fees + attestations

app_worker --> accounts : UserOperations
payments_worker --> home_router : quote / reconcile
payments_worker --> base_router : quote / reconcile
payments_worker --> avax_router : quote / reconcile
base_router --> base_cctp : burn
avax_router --> avax_cctp : burn
payments_worker --> arb_cctp : receiveMessage
arb_cctp --> arb_cctp : mint USDC al comercio

phase3_candidate ..> client_dist : próximo deploy App Web
phase3_candidate ..> app_worker : próximo deploy App Worker
phase3_candidate ..> app_d1 : próxima migración 0035

note bottom of payments_worker
  PAYMENT_LIVE_ENABLED=false.
  Sólo testnets están habilitadas en este corte.
  Migración 0006 y hardening de attempt desplegados.
  Fase 4 debe aportar pagos E2E con evidencia.
end note

legend right
  |= Color |= Estado |
  |<#DCFCE7> Verde | Existe remotamente |
  |<#FEF3C7> Amarillo | Preparado; aún no promovido |
  |<#E5E7EB> Gris | Histórico o futuro, fuera del runtime activo |
  |<#FCE7F3> Rosa | Secret/binding, nunca valor plano |
  |<#EDE9FE> Violeta | Proveedor o red externa |
endlegend

@enduml
