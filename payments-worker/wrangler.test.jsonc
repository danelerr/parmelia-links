{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gatopago-payments-runtime-test-base",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "runtime-test": {
      "name": "gatopago-payments-runtime-test",
      "vars": {
        "FIREBASE_PROJECT_ID": "runtime-test-project",
        "ALLOWED_ORIGINS": "https://app.parmelia.me",
        "SETTLEMENT_CHAIN_ID": "421614",
        "PAYMENT_ENABLED_CHAIN_IDS": "421614,84532,43113",
        "PAYMENTS_BOOTSTRAP_MODE": "false",
        "PAYMENTS_DATA_CUTOVER_CHECKSUM": "1111111111111111111111111111111111111111111111111111111111111111",
        "PAYMENT_AUTHORIZATION_TTL_SECONDS": "600",
        "CIRCLE_API_BASE_URL": "https://iris-api-sandbox.circle.com",
        "CHECKOUT_BASE_URL": "https://app.parmelia.me/pay"
      },
      "d1_databases": [{
        "binding": "PAYMENTS_DB",
        "database_name": "gatopago-payments-runtime-test",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "migrations"
      }],
      "durable_objects": {
        "bindings": [{ "name": "PAYMENT_JOB_SCHEDULER", "class_name": "PaymentJobScheduler" }]
      },
      "migrations": [{ "tag": "v1_payment_job_scheduler", "new_sqlite_classes": ["PaymentJobScheduler"] }],
      "queues": {
        "producers": [{ "binding": "PAYMENT_JOBS_QUEUE", "queue": "gatopago-payment-jobs-runtime-test" }],
        "consumers": [{ "queue": "gatopago-payment-jobs-runtime-test", "max_batch_size": 1 }]
      }
    }
  }
}
