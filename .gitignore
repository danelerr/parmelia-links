.vercel
node_modules
.env
.env.*
.dev.vars
.dev.vars.*

# Secrets — never commit. Firebase service account keys go to `wrangler secret`.
*-firebase-adminsdk-*.json
*service-account*.json

# OS / editor junk
.DS_Store
*.DS_Store
Thumbs.db

# This is a pnpm workspace — never commit npm lockfiles or per-package pnpm locks.
# The single source of truth is the root pnpm-lock.yaml.
package-lock.json
client/pnpm-lock.yaml
server/pnpm-lock.yaml
shared/pnpm-lock.yaml

# Playwright runtime artifacts.
test-results/
playwright-report/
.playwright-cli/
output/
coverage/
*.log

# Temporary assets & exports
logos-mover/
ava-deck.*

# Local Cloudflare/D1 state created by integration and restore drills.
.ci-d1/

# Generated Foundry coverage report and broadcast logs.
contracts/lcov.info
contracts/broadcast/**/run-*.json
!contracts/broadcast/**/run-latest.json

# Encrypted D1 exports and manifests contain production metadata/data.
backups/
.release/

# Editor config
.vscode/
.idea/

# NOTE: .agents/skills/ is intentionally vendored (committed) for now.
# The `npx skills` toolchain has no "install everything from skills-lock.json"
# command yet (vercel-labs/skills#283), so the only restore path is re-adding each
# skill by hand. Once that command ships, gitignore .agents/ and restore from the lockfile.

.vercel
