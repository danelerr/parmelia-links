# Compiler and build output. `contracts/out` is intentionally untracked, but
# shared/index.ts consumes selected ABIs from it. Wrangler and the verification
# scripts regenerate it with `forge build` before bundling or testing.
cache/
out/
lcov.info

# Dependencies
/lib
/node_modules

# Environment files
.env
.env.*
!.env.example

# Broadcast execution logs (keep run-latest.json, ignore timestamped runs and dry-runs)
/broadcast/**/run-*.json
!/broadcast/**/run-latest.json
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Editor and OS junk
.DS_Store
*.DS_Store
.vscode/
.idea/
