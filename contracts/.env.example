# Arbitrum Sepolia RPC URL (e.g. public endpoint or Alchemy/Infura)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployer private key (can load dynamically from Cast or put hex string)
PRIVATE_KEY=$(cast wallet private-key --account wallet-0x75)

# Arbiscan API Key (used by forge verify-contract)
ETHERSCAN_API_KEY=
