# RPCs used by the Universal Checkout testnet preflights/fork proofs.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Public role addresses. Testnets may deliberately reuse the deployer; mainnet
# validation requires separated roles. Never put a private key in this file.
GATOPAGO_CONTRACT_OWNER=0x0000000000000000000000000000000000000000
GATOPAGO_TREASURY=0x0000000000000000000000000000000000000000
GATOPAGO_PAYMENT_ROUTER_SIGNER=0x0000000000000000000000000000000000000000
GATOPAGO_PAUSE_GUARDIAN=0x0000000000000000000000000000000000000000

# Pilot policy: no GatoPago platform fee on the CCTP source routers.
GATOPAGO_CCTP_PLATFORM_FEE_CAP_BPS=0

# Pass signing authority through Foundry's --account/keystore support. API keys
# below are optional and only used for explorer source verification.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
SNOWTRACE_API_KEY=
