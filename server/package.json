{
  "name": "server",
  "type": "module",
  "scripts": {
    "pretest": "pnpm --dir .. build:contracts",
    "dev": "wrangler dev",
		"deploy": "node ../scripts/deploy-app-worker.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --check",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:unit && pnpm test:worker-runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker-runtime": "vitest run --config vitest.worker.config.ts",
    "typecheck:worker-runtime": "tsc --noEmit --project test-worker/tsconfig.json"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "hono": "^4.13.3",
    "jose": "^6.2.10",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0",
    "yaml": "^2.9.0"
  }
}
