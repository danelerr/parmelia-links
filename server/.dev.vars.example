# Local dev secrets (copy to server/.dev.vars — gitignored). Production uses
# `wrangler secret put` for each of these; see server/README.md.

# Token aleatorio de al menos 32 caracteres para GET /health/ops. Si falta o es
# corto, el endpoint detallado responde 404; /health y /health/live no lo usan.
OPS_HEALTH_TOKEN=

# Compatibilidad/base: RPC del chain activo; acepta URLs separadas por coma.
RPC_URL=

# Roles opcionales. Si faltan heredan RPC_URL.
# READ/WRITE: lecturas puntuales y broadcast.
# INDEXER: endpoints para eth_getLogs, ordenados igual que sus capacidades.
RPC_READ_URLS=
RPC_WRITE_URLS=
RPC_INDEXER_URLS=
RPC_ARCHIVE_URLS=
RPC_TIMEOUT_MS=10000
# Configuración NO secreta por slot. Permite mezclar proveedores/planes sin
# codificarlos en el código. Si se omite, cada endpoint indexer hereda el rango
# legacy de RPC_INDEXER_MAX_BLOCK_RANGE.
# Ejemplo con dos endpoints de capacidades distintas:
# {"indexer":[{"id":"managed","priority":0,"maxConcurrency":4,"maxLogRange":10},{"id":"public","priority":1,"maxConcurrency":2,"maxLogRange":2000}]}
RPC_PROVIDER_CAPABILITIES=

# ERC-4337 submission. `self` conserva el handleOps propio; `bundler` elimina
# el nonce único del relayer. El proveedor DEBE anunciar soporte para el
# EntryPoint v0.9 de GatoPago; la app lo verifica antes de enviar.
RELAYER_MODE=self
BUNDLER_RPC_URLS=
BUNDLER_ROLLOUT_PERCENT=0
# Firma dummy estructural para eth_estimateUserOperationGas si el proveedor la
# exige. No es secreta; dejar 0x hasta validar el bundler elegido.
BUNDLER_DUMMY_SIGNATURE=0x
# Sólo para contingencia explícita: ante falla transitoria del bundler vuelve a
# handleOps propio. Mantener false normalmente para no ocultar degradaciones.
BUNDLER_SELF_FALLBACK=false

# Compatibilidad si RPC_PROVIDER_CAPABILITIES no está configurado. Con el
# documento de capacidades, cada endpoint declara su propio máximo y el scanner
# elige/falla hacia otro proveedor de forma adaptativa.
RPC_INDEXER_MIN_BLOCK_RANGE=10
RPC_INDEXER_MAX_BLOCK_RANGE=2000
INDEXER_WALLET_SHARD_SIZE=250
INDEXER_REGISTRY_BATCH_SIZE=25
INDEXER_MAX_RPC_CALLS_PER_JOB=16
INDEXER_MAX_BLOCKS_PER_JOB=20000
INDEXER_MAX_EVENT_BLOCKS_PER_JOB=8
# Webhook = vía rápida; este alarmado reconciliador es la garantía autónoma.
# Se rearma sólo si hay shards con wallets activas y se apaga con cero wallets.
INDEXER_SAFETY_SWEEP_SECONDS=3600
BALANCE_MAX_STALENESS_SECONDS=300
# Sólo activos rpc_only (ETH/aUSDC) se auditan por tiempo. Este trabajo es
# global y acotado; abrir Home nunca crea un refresh por snapshot viejo.
# Política GatoPago: una inclusión de batch sólo asciende a l1_confirmed al
# alcanzar este umbral. No equivale a assertion/finality del Rollup.
ARBITRUM_L1_CONFIRMATIONS_REQUIRED=12

# Address Activity se usa como señal push; el pool RPC conserva la verdad.
# Rotar cualquier key que haya aparecido en una captura antes de habilitarlo.
ALCHEMY_WEBHOOK_ENABLED=false
ALCHEMY_CUSTOM_WEBHOOK_ENABLED=false
ALCHEMY_CUSTOM_WEBHOOK_ID=
ALCHEMY_CUSTOM_WEBHOOK_SIGNING_KEY=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_WEBHOOK_NETWORK=ARB_SEPOLIA
ALCHEMY_WEBHOOK_SIGNING_KEY=
# Escala horizontal opcional. Este secreto JSON reemplaza las tres variables
# anteriores y permite varios webhooks, cada uno con hasta 200 shards estables:
# [{"id":"wh_1","network":"ARB_SEPOLIA","signingKey":"..."},{"id":"wh_2","network":"ARB_SEPOLIA","signingKey":"..."}]
ALCHEMY_ADDRESS_WEBHOOKS_JSON=
# Token de administración de Notify (X-Alchemy-Token), distinto del API key RPC.
ALCHEMY_NOTIFY_AUTH_TOKEN=

# EOA operativa del relayer (handleOps/CCTP). No reutilizar en mainnet.
PRIVATE_KEY=

# EOA que conserva y transfiere exclusivamente el presupuesto del faucet.
# En MAINNET es obligatoria y distinta si FAUCET_ENABLED=true.
FAUCET_PRIVATE_KEY=

# Guardian de recovery. Obligatoria y distinta de PRIVATE_KEY en MAINNET.
RECOVERY_GUARDIAN_PRIVATE_KEY=

# Firma de sponsorships del paymaster. En MAINNET es obligatoria (sin fallback).
PAYMASTER_SIGNER_PRIVATE_KEY=

# Sponsorship se elige en runtime; cambiar proveedor no migra smart accounts.
# Valores: parmelia | erc7677 | self-funded. El fallback ocurre antes de la firma.
SPONSORSHIP_PROVIDER=parmelia
SPONSORSHIP_FALLBACK_PROVIDER=
# Permite rotar/reemplazar el paymaster propio sin cambiar shared/networks.ts.
SPONSORSHIP_PAYMASTER_ADDRESS=
SPONSORSHIP_HEALTH_CHECK_ENABLED=true
PAYMASTER_MIN_DEPOSIT_WEI=1000000000000000
# ERC-7677 (solo si el proveedor seleccionado lo requiere).
PAYMASTER_SERVICE_URL=
PAYMASTER_SERVICE_CONTEXT_JSON={}
PAYMASTER_SERVICE_EXPECTED_PAYMASTER=
PAYMASTER_SERVICE_TIMEOUT_MS=8000

# Política comercial de las operaciones de la app (swap/cross-chain personal y
# compatibilidad legacy). El switch maestro debe seguir false: valores BPS
# aislados nunca activan una comisión por accidente.
GATOPAGO_FEES_ENABLED=false
GATOPAGO_SWAP_FEE_BPS=0
GATOPAGO_CROSSCHAIN_FEE_BPS=0
GATOPAGO_MAX_FEE_BPS=100
GATOPAGO_TREASURY_ADDRESS=

# Firma de autorizaciones del PaymentRouter (Flow B). En MAINNET es obligatoria.
PAYMENT_ROUTER_SIGNER_PRIVATE_KEY=

# Clave AES-GCM de 32 bytes (base64 o 64 hex) para secretos de webhook en D1.
# Obligatoria en MAINNET. Ejemplo de generación: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=
# ID no secreto de la clave activa. Cambiarlo en cada rotación.
WEBHOOK_SECRET_ENCRYPTION_KEY_ID=2026_07
# Durante una rotación: JSON {"id_anterior":"clave_anterior"}. Vaciar después
# de que el job de rotación haya recifrado todas las filas con el ID activo.
WEBHOOK_SECRET_ENCRYPTION_KEYS_PREVIOUS={}

CHAIN_KEY=arbitrum-sepolia

# Fase 4A: redes visibles y rails monetarios son listas distintas. Mostrar
# Avalanche Fuji no autoriza crear cuentas ni enviar operaciones allí. El rail
# debe permanecer cerrado hasta desplegar/verificar/fondear sus contratos.
APP_ENABLED_CHAIN_KEYS=arbitrum-sepolia,avalanche-fuji
APP_WALLET_RAIL_CHAIN_KEYS=arbitrum-sepolia
# JSON chainId -> URLs separadas por coma, o por rol. Las URLs con API keys son
# secrets. Ejemplo Fuji por rol:
# {"43113":{"read":"https://rpc-a.example,https://rpc-b.example","write":"https://rpc-a.example","indexer":"https://rpc-b.example","archive":"https://rpc-c.example","bundler":"https://bundler.example"}}
APP_CHAIN_RPC_URLS=

# Anti-abuso Turnstile. Testnet: opcional (sin definir = se omite).
# MAINNET: obligatorio — sin el, /account/create y /account/fund fallan cerrado.
TURNSTILE_SECRET_KEY=

# Faucet: testnet activo salvo "false" (presupuesto por defecto 500 USDC/dia).
# Mainnet exige FAUCET_ENABLED=true y un presupuesto positivo explicito.
FAUCET_ENABLED=true
FAUCET_DAILY_BUDGET_USDC=500

# JSON del service account de FCM en 1 linea (opcional; sin definir = sin push).
FCM_SERVICE_ACCOUNT=

# Autenticacion por Google y magic links nativos de Firebase.
# FIREBASE_SERVICE_ACCOUNT puede usar la misma cuenta de servicio que FCM, pero
# se mantiene separado para rotacion y minimo privilegio. FIREBASE_WEB_API_KEY
# es la clave publica del SDK web y permite solicitar EMAIL_SIGNIN al endpoint
# oficial de Firebase; no es una credencial de un proveedor de correo externo.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_WEB_API_KEY=
# Secreto aleatorio de al menos 32 caracteres; HMAC de desafios de recovery y
# compatibilidad temporal con los codigos legacy del futuro producto Business.
# Ejemplo: openssl rand -base64 48
AUTH_CODE_PEPPER=
# Opcional: remitente de alertas de seguridad/compatibilidad legacy mediante el
# binding EMAIL. El inicio de sesion de la App no depende de este valor.
AUTH_EMAIL_FROM=acceso@parmelia.me

# Origen publico exacto autorizado en Firebase; destino de los magic links y
# enlaces de checkout. En desarrollo puede ser http://localhost:5173.
APP_URL=https://app.parmelia.me

# Contrato publico WebAuthn. El RP ID no es un secret y NO debe derivarse del
# host del frontend. Para desarrollo local usar localhost y su origen exacto.
PASSKEY_RP_ID=localhost
PASSKEY_ALLOWED_ORIGINS=http://localhost:5173

# Opcional: JSON chainId->RPC para destinos CCTP. APP_CHAIN_RPC_URLS es la
# fuente canónica del rail App; este mapa queda para compatibilidad cross-chain.
CCTP_RPC_URLS=

# Kill switches y controles operativos.
CROSSCHAIN_PAUSED=false
CROSSCHAIN_DISABLED_CHAINS=
CROSSCHAIN_MIN_RELAYER_GAS_WEI=500000000000000
EARN_PAUSED=false
