{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-08",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8787,
  },

  "vars": {
    "FIREBASE_PROJECT_ID": "proyecto-prueba-push-firebase",
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true,
    },
  },
  "kv_namespaces": [
    // {
    // 	"binding": "PARMELIA_KV",
    // 	"id": "local-dev-placeholder"
    // },
    {
      "binding": "PARMELIA_KV",
      "id": "755adbb2a53c442dbf05de55e2423186",
      "remote": true,
    }
  ],
}
