{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-16",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8787,
  },

  "vars": {
    // Non-sensitive runtime config only. Secrets like PRIVATE_KEY and RPC_URL
    // must be configured via `wrangler secret put` or local `.dev.vars`.
    "FIREBASE_PROJECT_ID": "proyecto-prueba-push-firebase",
    "CHAIN_KEY": "arbitrum-sepolia",
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },

  "d1_databases": [
    {
      "binding": "PARMELIA_DB",
      "database_name": "parmeliadb",
      "database_id": "1c1352dd-1ccb-4f55-a679-4a9ba24375be",
      "preview_database_id": "1c1352dd-1ccb-4f55-a679-4a9ba24375be",
      "migrations_dir": "migrations",
    },
  ],
}
