{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server-runtime-test-base",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "runtime-test": {
      "name": "server-runtime-test",
      "vars": {
        "FIREBASE_PROJECT_ID": "runtime-test-project",
        "CHAIN_KEY": "arbitrum-sepolia",
        "ALLOWED_ORIGINS": "https://app.parmelia.me"
      },
      "d1_databases": [
        {
          "binding": "GATOPAGO_DB",
          "database_name": "parmelia-runtime-test",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
