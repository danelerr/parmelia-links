{
  "$schema": "./node_modules/knip/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "project": [
        "e2e/**/*.ts",
        "scripts/**/*.mjs"
      ],
      "ignoreBinaries": [
        "cast",
        "forge",
        "java"
      ]
    },
    "client": {
      "entry": [
        "public/sw.js"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}"
      ]
    },
    "dashboard": {
      "project": [
        "src/**/*.{ts,tsx,css}"
      ]
    },
    "server": {
      "entry": [
        "src/routes/crosschain.routes.ts",
        "src/routes/links.routes.ts",
        "src/routes/merchant.routes.ts",
        "src/services/indexer/routerWatcher.ts",
        "src/services/crosschainRelayer.ts",
        "src/services/webhooks.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test-worker/**/*.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "payments-worker": {
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test-worker/**/*.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "shared": {
      "project": [
        "**/*.ts"
      ]
    }
  }
}
