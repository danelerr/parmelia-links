{
	"name": "GatoPago",
	"short_name": "GatoPago",
	"description": "Tus dólares ya saben moverse. Cobra, paga, cambia y haz crecer dólares digitales desde una cuenta que tú controlas.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "portrait-primary",
	"background_color": "#fff8f0",
	"theme_color": "#0b0b0f",
	"lang": "es",
	"dir": "ltr",
	"categories": ["finance", "utilities"],
	"prefer_related_applications": false,
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/gatopago.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/icon-monochrome.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "monochrome"
		}
	],
	"shortcuts": [
		{
			"name": "Cobrar con GatoPago",
			"short_name": "Cobrar",
			"description": "Crea un enlace o un QR para cobrar.",
			"url": "/charge",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
		},
		{
			"name": "Pagar con GatoPago",
			"short_name": "Pagar",
			"description": "Envía un pago desde tu cuenta.",
			"url": "/send",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
		},
		{
			"name": "Escanear un QR",
			"short_name": "Escanear",
			"description": "Abre el escáner de pagos de GatoPago.",
			"url": "/scan",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
		}
	],
	"screenshots": [
		{
			"src": "/screenshot-dashboard.png",
			"sizes": "1082x2202",
			"type": "image/png",
			"form_factor": "narrow",
			"label": "Saldo, movimientos y accesos rápidos de GatoPago"
		},
		{
			"src": "/screenshot-charge.png",
			"sizes": "1082x2202",
			"type": "image/png",
			"form_factor": "narrow",
			"label": "Crear un enlace o QR de cobro"
		}
	]
}
